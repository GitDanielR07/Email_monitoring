# Example .env file
# Copy this to .env and fill in your actual values

# Discord Webhook URL for email notifications
DISCORD_WEBHOOK_EMAIL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN

# Discord User/Role ID to mention in embeds
DISCORD_MENTION_ID=YOUR_DISCORD_ID

# Your Gmail address to monitor
STUDENT_EMAIL=your.email@slu.edu.ph

# Gmail API credentials file (default: credentials.json)
GMAIL_CREDENTIALS_FILE=credentials.json

# Gmail OAuth token file (default: token.json)
GMAIL_TOKEN_FILE=token.json
