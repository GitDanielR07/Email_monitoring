# Copy this file to .env and fill in your values.

# ===== Discord =====
DISCORD_WEBHOOK_EMAIL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN
# Your Discord user ID; each email will @mention you (optional)
DISCORD_MENTION_ID=YOUR_DISCORD_USER_ID

# ===== Gmail =====
STUDENT_EMAIL=your.email@example.com
GMAIL_CREDENTIALS_FILE=config/credentials.json
GMAIL_TOKEN_FILE=config/token.json

# ===== Google Cloud Pub/Sub (push notifications) =====
GOOGLE_CLOUD_PROJECT=your-project-id
PUBSUB_TOPIC=gmail-notifications
PUBSUB_SUBSCRIPTION=gmail-notifications-sub
GOOGLE_APPLICATION_CREDENTIALS=config/service-account-key.json
